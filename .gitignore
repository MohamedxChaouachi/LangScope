# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── ML model caches (can be hundreds of MB — re-downloaded on first run) ──────
# EasyOCR keeps its models in ~/.EasyOCR, outside the repository. This entry only covers a
# copy that ends up in the working directory (for example when EasyOCR is run from here).
# Argos Translate packages and the PyTorch hub cache also live in the home directory, where a
# .gitignore cannot reach them, so there is nothing to list for them.
.EasyOCR/

# ── IDE / OS ──────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ── Logs & temp ───────────────────────────────────────────────────────────────
*.log
*.tmp
*.bak
diag_ocr.py
_patch_main.py

# ── Secrets / env ─────────────────────────────────────────────────────────────
.env
.env.*
secrets.py
